{
  "name": "shopnow-backend",
  "version": "1.0.0",
  "description": "ShopNow e-commerce backend API",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev":   "nodemon src/server.js",
    "test":  "jest --coverage --testPathPattern=tests/"
  },
  "dependencies": {
    "express":        "^4.18.2",
    "pg":             "^8.11.3",
    "redis":          "^4.6.12",
    "helmet":         "^7.1.0",
    "morgan":         "^1.10.0",
    "cors":           "^2.8.5",
    "prom-client":    "^15.1.0"
  },
  "devDependencies": {
    "jest":      "^29.7.0",
    "supertest": "^6.3.3",
    "nodemon":   "^3.0.2"
  },
  "jest": {
    "testEnvironment": "node",
    "coverageDirectory": "coverage",
    "collectCoverageFrom": ["src/**/*.js"],
    "coverageReporters": ["text", "lcov"]
  }
}
