# Copy to .env — used by docker-compose for local development only.
# Never commit .env to source control.

POSTGRES_DB=shopnow
POSTGRES_USER=shopnow
POSTGRES_PASSWORD=shopnow_local_dev

REDIS_PASSWORD=

BACKEND_URL=http://backend:5000
PORT=3000
DATABASE_URL=postgresql://shopnow:shopnow_local_dev@postgres:5432/shopnow
REDIS_URL=redis://redis:6379/0
CACHE_TTL=60
