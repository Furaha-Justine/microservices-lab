{
  "name": "shopnow-frontend",
  "version": "1.0.0",
  "description": "ShopNow e-commerce frontend",
  "main": "server.js",
  "scripts": {
    "start":  "node server.js",
    "dev":    "nodemon server.js",
    "test":   "jest --coverage --testPathPattern=tests/",
    "lint":   "eslint . --ext .js"
  },
  "dependencies": {
    "axios":              "^1.6.0",
    "express":            "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "helmet":             "^7.1.0",
    "morgan":             "^1.10.0"
  },
  "devDependencies": {
    "jest":      "^29.7.0",
    "nodemon":   "^3.0.2",
    "supertest": "^6.3.3"
  },
  "jest": {
    "testEnvironment": "node",
    "coverageDirectory": "coverage",
    "collectCoverageFrom": ["*.js"],
    "coverageReporters": ["text", "lcov"]
  }
}
